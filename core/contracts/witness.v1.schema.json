{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humkin.abundent.org/contracts/witness.v1.schema.json",
  "title": "Radio House Witness v1 (proposal only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "subject",
    "observation_type",
    "observed_at",
    "source",
    "result"
  ],
  "properties": {
    "schema": {
      "const": "humkin.radiohouse.witness/v1"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "observation_type": {
      "enum": [
        "source_inspection",
        "ci_test",
        "http_probe",
        "program_pointer",
        "device_audio",
        "human_report"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "inconclusive",
        "reported",
        "unverified"
      ]
    },
    "device": {
      "type": "string"
    },
    "recording_id": {
      "type": "string"
    },
    "program_revision": {
      "type": "string"
    },
    "limitations": {
      "type": "string"
    },
    "consent": {
      "enum": [
        "private",
        "consented_share",
        "public"
      ]
    },
    "verified_by": {
      "type": "string",
      "description": "Attribution only; does not authenticate signature"
    }
  }
}
