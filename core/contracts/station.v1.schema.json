{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humkin.abundent.org/contracts/station.v1.schema.json",
  "title": "Radio House Station v1 (proposal only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "station_id",
    "owner",
    "engines"
  ],
  "properties": {
    "schema": {
      "const": "humkin.radiohouse.station/v1"
    },
    "station_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string"
    },
    "engines": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "acer_live_hls",
          "cloud_autopilot_hls",
          "long_wave_mp3",
          "browser_same_time",
          "road_shuffle"
        ]
      }
    },
    "active_engine": {
      "type": [
        "string",
        "null"
      ],
      "description": "Informational proposal only; not a production mode switch"
    },
    "authorization_ref": {
      "type": "string",
      "description": "Read-only reference; never a token or direct authority grant"
    }
  }
}
